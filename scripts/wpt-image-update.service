[Unit]
Description=WPT IoT edge image update from GHCR
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/default/wpt-iot
ExecStart=/usr/local/sbin/wpt-image-update.sh
TimeoutStartSec=10min

[Install]
WantedBy=multi-user.target
