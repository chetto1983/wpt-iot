{
  "name": "create-wpt-iot",
  "version": "0.1.0",
  "description": "Interactive local and remote installer for WPT IoT edge devices",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chetto1983/wpt-iot.git",
    "directory": "packages/create-wpt-iot"
  },
  "type": "module",
  "bin": {
    "create-wpt-iot": "dist/bin.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc && node scripts/stamp-installer.mjs && node scripts/verify-installer-manifest.mjs",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:manifest": "node scripts/verify-installer-manifest.mjs",
    "verify:manifest:remote": "node scripts/verify-installer-manifest.mjs --remote",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.7.0",
    "execa": "^10.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
